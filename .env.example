# Copy to .env (never commit .env) or export these in your shell.
# All variables are optional; defaults live in assistant_core/config.py.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-small
ASSISTANT_DEBUG=false
ASSISTANT_CREDIT_RATE=450000
ASSISTANT_RETAKE_MULTIPLIER=1.5
ASSISTANT_MAX_CREDITS=30
# ASSISTANT_DATA_DIR=/path/to/data
# ASSISTANT_HISTORY_DIR=/path/to/history

# --- Lab 4: HTTP API ---------------------------------------------------------
# Admin key for GET /v1/feedback (sent in the X-API-Key header). Change it; never commit the real value.
# If empty, the admin endpoint rejects every request (401).
ASSISTANT_API_ADMIN_KEY=change-me
ASSISTANT_WEATHER_URL=https://api.open-meteo.com/v1/forecast
ASSISTANT_WEATHER_TIMEOUT_S=3
# University of Science, HCMC (Nguyen Van Cu campus)
ASSISTANT_CAMPUS_LAT=10.7626
ASSISTANT_CAMPUS_LON=106.6822
ASSISTANT_RATE_LIMIT_PER_MIN=30

# --- Lab 5: database ----------------------------------------------------------
ASSISTANT_DB_URL=sqlite:///assistant.db
# Secret salt used to hash session ids before they are stored (at least 8 characters).
# The value below is a DEV PLACEHOLDER. Generate your own and never commit .env:
#   python -c "import secrets; print(secrets.token_hex(32))"
ASSISTANT_HASH_SALT=dev-only-salt-change-me
